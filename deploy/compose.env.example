# Copy outside the checkout, then use docker compose --env-file /path/to/compose.env.
GUAVAJAM_SOURCE_URL=https://github.com/example/publication.git
GUAVAJAM_SOURCE_REF=refs/heads/main
GUAVAJAM_POLL_SECONDS=300
# Directory containing independent allowed_signers; optional ssh_config/known_hosts/key.
GUAVAJAM_TRUST_DIR=/absolute/path/to/operator-trust
GUAVAJAM_SSH_ALLOWED_SIGNERS=/trust/allowed_signers
GUAVAJAM_BIND_ADDRESS=127.0.0.1
GUAVAJAM_PORT=8080
# Alternative GPG trust: clear GUAVAJAM_SSH_ALLOWED_SIGNERS and supply BOTH:
# GUAVAJAM_TRUSTED_GPG_FINGERPRINTS=FULL_PUBLIC_FINGERPRINT
# GUAVAJAM_GPG_PUBLIC_KEYS=/trust/publisher.asc

# Optional local-assets profile; operator HTTPS ingress terminates TLS.
ASSET_HOST=assets.publisher.example
S3_ENDPOINT=https://s3.publisher.example
S3_REGION=us-east-1
S3_BUCKET=publication-assets
# Private SeaweedFS identities: staged uploads, read-only delivery, release, maintenance.
# Public gateway reads .released/ records only; never provision release writes to uploaders.
SEAWEEDFS_IDENTITIES=/absolute/path/to/s3-identities.json
S3_ACCESS_KEY_ID_FILE=/absolute/path/to/delivery-access-key
S3_SECRET_ACCESS_KEY_FILE=/absolute/path/to/delivery-secret-key
GUAVAJAM_ASSET_PORT=8081
GUAVAJAM_S3_PORT=8333

# Optional authenticated preview of a local authoring branch; start only private-preview.
GUAVAJAM_PREVIEW_SOURCE=./deploy/source
GUAVAJAM_PREVIEW_REF=refs/heads/draft
GUAVAJAM_PREVIEW_BASE_REF=refs/heads/main
GUAVAJAM_PREVIEW_WORK=sample-work
GUAVAJAM_PREVIEW_ORIGIN=http://127.0.0.1:8082
# Use https://preview.example.org only behind authenticated operator-controlled HTTPS ingress.
GUAVAJAM_PREVIEW_TOKEN_FILE=./deploy/private/session.key
GUAVAJAM_PREVIEW_READONLY_ENV=./deploy/private/readonly.env
GUAVAJAM_PREVIEW_PORT=8082
