{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Press source-owned site settings v1",
  "description": "Executable validators additionally enforce signed publication membership, exact URI/DOI normalization, chronology, successor integrity and append-only deployed bindings.",
  "type": "object",
  "required": [
    "schema",
    "publisher",
    "base_url"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "press.site.v1"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "base_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^?#]+[^/]$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "language": {
      "const": "en"
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "source_view": {
      "type": "string",
      "pattern": "^https://"
    },
    "works": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "concept_doi": {
            "type": "string",
            "pattern": "^10\\.[0-9]{4,9}/"
          },
          "metadata_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "recommended_revision": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "editions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "published": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\.[0-9]{4,9}/"
          },
          "status": {
            "enum": [
              "available",
              "superseded",
              "withdrawn",
              "unavailable"
            ]
          },
          "notices": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": [
                "date",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                }
              }
            }
          },
          "successor_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    }
  }
}
