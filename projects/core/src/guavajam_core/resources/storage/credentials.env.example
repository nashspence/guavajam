# Private, ignored, owner-only (0600). Configure an existing bucket, not a public asset URL.
# Base permissions: object read/write and listing under sha256/. Cleanup also needs deletion.
# Version inventory and Object Lock are OPTIONAL; enable only for a configured bucket.
# Use read-only storage credentials when deploying the gateway.
S3_ENDPOINT=https://objects.example.org
S3_REGION=replace-me
S3_BUCKET=replace-me
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_SESSION_TOKEN=''
S3_ADDRESSING_STYLE=path
S3_VERSIONING=off
S3_OBJECT_LOCK=off
S3_CONDITIONAL_WRITES=off
