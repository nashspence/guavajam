 class ContractTests(unittest.TestCase):
+    def test_external_links_follow_the_shared_source_contract(self):
+        from guavajam.validate_sources import valid_source_link
+        from a_guavajam_static_website_generator.renderer import _href
+        targets = {
+            'mailto:author@example.org?subject=Question&body=Hello%20world': True,
+            'https://example.org/paper?edition=first#section': True,
+            'https:missing-authority': False,
+            'mailto://example.org/address': False,
+            'javascript:alert(1)': False,
+            'data:text/html,example': False,
+            'file:///tmp/example': False,
+            'http://example.org/paper': False,
+        }
+        for target, accepted in targets.items():
+            with self.subTest(target=target):
+                self.assertEqual(accepted, valid_source_link(target))
+                options = dict(kind='Link', path='content/manuscript.md', sha='0' * 40,
+                               repo=None, origin='', supporting={}, downloads={})
+                if accepted:
+                    self.assertEqual(target, _href(target, **options))
+                else:
+                    with self.assertRaises(RenderError):
+                        _href(target, **options)
+
+    def test_shared_source_link_validation_does_not_relax_renderer_credentials(self):
+        from guavajam.validate_sources import valid_source_link
+        from a_guavajam_static_website_generator.renderer import _href
+        target = 'https://reader:example-only@example.org/paper'
+        # Existing source acceptance cannot be tightened retroactively here.
+        # The renderer's credential restriction remains an explicit boundary.
+        self.assertTrue(valid_source_link(target))
+        with self.assertRaises(RenderError):
+            _href(target, kind='Link', path='content/manuscript.md', sha='0' * 40,
+                  repo=None, origin='', supporting={}, downloads={})
+
