+    def test_accepted_source_links_survive_historical_regeneration(self):
+        links = [
+            'mailto:author@example.org?subject=Question&body=Hello%20world',
+            'https://example.org/paper?edition=first#section',
+        ]
+        body = '\n\n'.join(f'[Source {number}]({target})' for number, target in enumerate(links))
+        self.publisher.source('Linked edition', body)
+        supporting = self.publisher.repo / 'content/supporting'
+        supporting.mkdir()
+        (supporting / 'note.md').write_text('---\ntitle: Linked note\n---\n\n<a name="links"></a>\n\n' + body.replace('\n\n', ' ') + '\n')
+        linked = self.publisher.publish('Publish source-approved links')
+        self.publisher.source('Later edition', 'The current edition no longer contains those links.')
+        (supporting / 'note.md').unlink()
+        latest = self.publisher.publish('Remove the links from the current edition')
+        catalog, _ = discover(self.publisher.repo, **self.publisher.trust)
+        self.assertEqual(self.publisher.revisions, [item['revision'] for item in catalog['editions']])
+        self.assertEqual(latest, catalog['editions'][-1]['revision'])
+
+        self.build()
+
+        reader = self.output / 'editions' / linked / 'read'
+        for relative in ['index.html', 'supporting/note.html']:
+            markup = (reader / relative).read_text()
+            for target in links:
+                self.assertIn('href="' + escape(target, quote=True) + '"', markup)
+        self.assertTrue((self.output / 'editions' / latest / 'read/index.html').is_file())
+
