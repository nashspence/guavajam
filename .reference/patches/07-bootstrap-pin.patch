+    def test_documented_initializers_pin_the_executed_packages(self):
+        examples = re.findall(r'```sh\n(.*?)```', (ROOT / 'README.md').read_text(), re.S)
+        initializers = [example for example in examples if re.search(r'\binit (?:work|index)\b', example)]
+        self.assertEqual({'work', 'index'}, {
+            kind for example in initializers for kind in re.findall(r'\binit (work|index)\b', example)
+        })
+        for example in initializers:
+            references = re.findall(r"git\+https://github\.com/nashspence/guavajam\.git[^'\s]*", example)
+            self.assertTrue(references, 'initializer examples must identify their package source')
+            revisions = set()
+            for reference in references:
+                with self.subTest(reference=reference):
+                    match = re.fullmatch(
+                        r'git\+https://github\.com/nashspence/guavajam\.git@'
+                        r'(<reviewed-sha>|[0-9a-f]{40})(?:#subdirectory=[A-Za-z0-9/_-]+)?', reference)
+                    self.assertIsNotNone(match, 'pin the executing initializer, not only its generated workflow')
+                    revisions.add(match[1])
+            self.assertEqual(1, len(revisions), 'initializer packages must use the same reviewed revision')
+
