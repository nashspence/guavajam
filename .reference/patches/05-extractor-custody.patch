+def review_output_path(candidate):
+    """Prove the resolved output is outside a worktree before writing private text."""
+    output = candidate.parent.resolve(strict=True) / candidate.name
+    if output.suffix != ".md":
+        raise ValueError("review output must be a GFM .md file")
+    # A marker is enough to refuse custody even when Git cannot read the
+    # repository, or its configuration would make discovery report 'false'.
+    for directory in (output.parent, *output.parent.parents):
+        try:
+            (directory / '.git').lstat()
+        except FileNotFoundError:
+            continue
+        except OSError as exc:
+            raise ValueError("cannot verify private review output is outside Git worktrees") from exc
+        raise ValueError("private review output must be outside Git worktrees")
+    # The output directory, not an inherited Git invocation, defines custody.
+    environment = {key: value for key, value in os.environ.items() if not key.startswith('GIT_')}
+    environment.update(LC_ALL='C', GIT_DISCOVERY_ACROSS_FILESYSTEM='1')
+    try:
+        custody = subprocess.run(['git', '-C', str(output.parent), 'rev-parse', '--is-inside-work-tree'],
+                                 capture_output=True, text=True, timeout=15, env=environment)
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        raise ValueError("cannot verify private review output is outside Git worktrees") from exc
+    if custody.returncode == 0 and custody.stdout.strip() == 'true':
+        raise ValueError("private review output must be outside Git worktrees")
+    if custody.returncode == 0 and custody.stdout.strip() == 'false' and not custody.stderr.strip():
+        return output
+    # Git uses 128 for both absence and failures. Accept only its C-locale
+    # absence diagnostic; configuration, ownership and other failures refuse.
+    absent = 'fatal: not a git repository (or any of the parent directories): .git'
+    if custody.returncode == 128 and not custody.stdout.strip() and custody.stderr.strip() == absent:
+        return output
+    raise ValueError("cannot verify private review output is outside Git worktrees")
+
