+    def test_example_release_identity_matches_generated_policy_and_runtime_prefix(self):
+        from guavajam.local_assets import role_actions
+        from guavajam.object_store import PREFIX, RELEASE_PREFIX
+
+        example = json.loads((APP / 'deploy/s3-identities.example.json').read_text())
+        roles = {identity['name']: identity['actions'] for identity in example['identities']}
+        settings = (APP / 'deploy/compose.env.example').read_text()
+        bucket_match = re.search(r'^S3_BUCKET=(\S+)$', settings, re.M)
+        self.assertIsNotNone(bucket_match)
+        bucket = bucket_match[1]
+        self.assertEqual(role_actions(bucket)['release'], roles['release'])
+
+        def can_write(role, key):
+            return any(fnmatch.fnmatchcase(bucket + '/' + key, action.removeprefix('Write:'))
+                       for action in roles[role] if action.startswith('Write:'))
+
+        release_record = RELEASE_PREFIX + 'a' * 64 + '.png.json'
+        staged_asset = PREFIX + 'a' * 64 + '.png'
+        self.assertTrue(can_write('release', release_record))
+        self.assertFalse(can_write('publisher', release_record))
+        self.assertFalse(can_write('release', staged_asset))
+        self.assertIn(RELEASE_PREFIX, settings)
+        self.assertNotIn('.released/', settings)
+
