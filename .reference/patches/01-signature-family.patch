diff --git a/tests/guavajam/test_signature_family.py b/tests/guavajam/test_signature_family.py
new file mode 100644
index 0000000000000000000000000000000000000000..5b3eef0c2a7872a52c382a48bcd7398e799f2b4e
--- /dev/null
+++ b/tests/guavajam/test_signature_family.py
@@ -0,0 +1,106 @@
+"""Bind the selected publisher policy to the signature Git actually verifies."""
+import base64
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from guavajam.asset_policy import AssetError
+from guavajam.trusted_git import verify_signature
+from guavajam_test_support.discovery_fixture import Publisher
+
+
+FIXTURES = Path(__file__).resolve().parents[1] / 'fixtures/signatures'
+GPG_FINGERPRINT = '968479A1AFF927E37D1A566BB5690EEEBB952194'
+
+
+def openpgp_commit():
+    record = json.loads((FIXTURES / 'openpgp-commit.json').read_text())
+    return base64.b64decode(record['data'], validate=True)
+
+
+class SignatureFamilyTests(unittest.TestCase):
+    def setUp(self):
+        self.root = Path(self.enterContext(tempfile.TemporaryDirectory()))
+        self.publisher = Publisher(self.root)
+        self.repo = self.publisher.repo
+
+    def object(self, raw):
+        return subprocess.check_output(['git', 'hash-object', '-w', '-t', 'commit', '--stdin'],
+                                       cwd=self.repo, input=raw).decode().strip()
+
+    def no_verifier(self, revision, **trust):
+        original = subprocess.run
+        verification = []
+        def run(command, **kwargs):
+            if 'verify-commit' in command:
+                verification.append(command)
+            return original(command, **kwargs)
+        with patch('guavajam.trusted_git.subprocess.run', side_effect=run):
+            with self.assertRaises(AssetError):
+                verify_signature(self.repo, revision, **trust)
+        self.assertEqual([], verification, 'reject incompatible source before any verifier backend runs')
+
+    def test_actual_ssh_signature_requires_the_ssh_policy(self):
+        revision = self.publisher.revisions[-1]
+        self.assertEqual('external-ssh-allowed-signers',
+                         verify_signature(self.repo, revision, **self.publisher.trust))
+        self.no_verifier(revision, fingerprints=[GPG_FINGERPRINT])
+
+    def test_openpgp_signature_is_rejected_before_ssh_verification_dispatch(self):
+        # Public fixture: guavajam's GitHub-signed main commit 54fce07. No signing
+        # secrets, network requests, or reachable source history are required.
+        revision = self.object(openpgp_commit())
+        self.no_verifier(revision, **self.publisher.trust)
+
+    @unittest.skipUnless(shutil.which('gpg'), 'OpenPGP verifier is not installed')
+    def test_ambient_gpg_trust_cannot_satisfy_an_unrelated_ssh_policy(self):
+        revision = self.object(openpgp_commit())
+        home = self.root / 'gpg'; home.mkdir(mode=0o700)
+        env = {**os.environ, 'GNUPGHOME': str(home), 'GIT_CONFIG_GLOBAL': os.devnull,
+               'GIT_CONFIG_SYSTEM': os.devnull}
+        # Some containers cannot launch gpg-agent; importing this public key can
+        # still succeed. Assert the actual key is present and verify the real
+        # signature, instead of skipping the authorization test on that warning.
+        subprocess.run(['gpg', '--batch', '--no-autostart', '--import'],
+                       input=(FIXTURES / 'openpgp-public-key.asc').read_bytes(), env=env,
+                       capture_output=True, timeout=30, check=False)
+        keys = subprocess.run(['gpg', '--batch', '--with-colons', '--list-keys', GPG_FINGERPRINT],
+                              env=env, capture_output=True, timeout=30, check=True)
+        self.assertIn(GPG_FINGERPRINT.encode(), keys.stdout)
+        subprocess.run(['gpg', '--batch', '--import-ownertrust'], env=env,
+                       input=(GPG_FINGERPRINT + ':6:\n').encode(),
+                       capture_output=True, timeout=30, check=True)
+        with patch.dict(os.environ, env):
+            self.assertEqual(GPG_FINGERPRINT,
+                             verify_signature(self.repo, revision, fingerprints=[GPG_FINGERPRINT]))
+            with self.assertRaises(AssetError):
+                verify_signature(self.repo, revision, **self.publisher.trust)
+
+    def test_unknown_duplicate_and_oversized_signatures_do_not_dispatch(self):
+        raw = openpgp_commit()
+        header, message = raw.split(b'\n\n', 1)
+        candidates = {
+            'unknown family': raw.replace(b'PGP SIGNATURE', b'SIGNED MESSAGE'),
+            'duplicate header': header + b'\ngpgsig -----BEGIN SSH SIGNATURE-----\n '
+                                b'-----END SSH SIGNATURE-----\n\n' + message,
+            'unselected alternate header': raw.replace(b'\ngpgsig ', b'\ngpgsig-sha256 '),
+            'oversized commit': raw + b'x' * 65536,
+        }
+        for name, candidate in candidates.items():
+            with self.subTest(case=name):
+                self.no_verifier(self.object(candidate), **self.publisher.trust)
+
+    def test_matching_armor_still_requires_a_valid_signature(self):
+        raw = subprocess.check_output(['git', 'cat-file', 'commit', self.publisher.revisions[-1]], cwd=self.repo)
+        changed = self.object(raw + b'Changed after signing.\n')
+        with self.assertRaises(AssetError):
+            verify_signature(self.repo, changed, **self.publisher.trust)
+
+
+if __name__ == '__main__':
+    unittest.main()
