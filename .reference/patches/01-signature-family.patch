index d0a6e61365505f2d31436ec2143ad302b274057c..aa0acc5ccc588ef94bdbd5e938d73cf8f01fee12 100644
--- a/src/guavajam/trusted_git.py
+++ b/src/guavajam/trusted_git.py
@@ -7,6 +7,58 @@ import subprocess
 from .asset_policy import AssetError
 
 
+def signature_format(repo, revision):
+    """Inspect a bounded raw commit before Git can dispatch to any verifier.
+
+    Git's gpg.format selects the signing default, not the verification backend.
+    A caller's SSH policy must never fall through to ambient OpenPGP/X.509 trust.
+    """
+    prefix = ['git', '--no-replace-objects', '-c', 'core.hooksPath=/dev/null']
+    options = dict(cwd=repo, capture_output=True, timeout=30, check=False,
+                   env={**os.environ, 'GIT_GRAFT_FILE': os.devnull})
+    try:
+        info = subprocess.run([*prefix, 'cat-file', '--batch-check=%(objecttype) %(objectsize)'],
+                              input=(revision + '\n').encode('ascii'), **options)
+        match = re.fullmatch(rb'commit ([0-9]+)\n', info.stdout)
+        if info.returncode or not match or len(info.stderr) > 65536:
+            raise AssetError('signature verification requires a readable commit object')
+        size = int(match[1])
+        if size > 65536:
+            raise AssetError('signature commit exceeds 64 KiB')
+        result = subprocess.run([*prefix, 'cat-file', 'commit', revision], **options)
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        raise AssetError('signature object inspection unavailable') from exc
+    if result.returncode or len(result.stdout) != size or len(result.stderr) > 65536:
+        raise AssetError('signature commit object could not be read exactly')
+    header, separator, _ = result.stdout.partition(b'\n\n')
+    if not separator:
+        raise AssetError('invalid signature commit header')
+    signatures, collecting = [], False
+    for line in header.split(b'\n'):
+        if line.startswith(b' '):
+            if collecting:
+                signatures[-1] += b'\n' + line[1:]
+            continue
+        name, _, value = line.partition(b' ')
+        collecting = name == b'gpgsig'
+        if name.startswith(b'gpgsig'):
+            if not collecting:
+                raise AssetError('unsupported commit signature header')
+            signatures.append(value)
+    if len(signatures) != 1:
+        raise AssetError('require exactly one supported commit signature')
+    armor = signatures[0].splitlines()
+    formats = {
+        b'-----BEGIN SSH SIGNATURE-----': ('ssh', b'-----END SSH SIGNATURE-----'),
+        b'-----BEGIN PGP SIGNATURE-----': ('openpgp', b'-----END PGP SIGNATURE-----'),
+    }
+    selected = formats.get(armor[0]) if armor else None
+    if (selected is None or armor[-1] != selected[1]
+            or sum(line.startswith(b'-----BEGIN ') for line in armor) != 1):
+        raise AssetError('unsupported or ambiguous commit signature format')
+    return selected[0]
+
+
 def verifier_arguments(repo,format):
     name='gpg' if format=='openpgp' else 'ssh-keygen'
     located=shutil.which(name)
@@ -24,6 +76,9 @@ def verify_signature(repo, revision, *, fingerprints=(), allowed_signers=None):
         raise AssetError('signature verification requires a full lowercase commit SHA-1')
     if bool(fingerprints) == bool(allowed_signers):
         raise AssetError('provide exactly one independent external GPG or SSH trust policy')
+    expected_format = 'openpgp' if fingerprints else 'ssh'
+    if signature_format(repo, revision) != expected_format:
+        raise AssetError('commit signature format does not match the independent trust policy')
     if fingerprints:
         trusted = {value.upper() for value in fingerprints}
         if any(not re.fullmatch(r'(?:[0-9A-F]{40}|[0-9A-F]{64})', value) for value in trusted):
